# Digital Twin AI Provider ("n8n" or "openrouter")
LLM_PROVIDER=n8n

# Self-hosted n8n Webhook + Ollama Agent
N8N_WEBHOOK_URL=https://your-n8n-host.example.com/webhook/digital-twin
N8N_WEBHOOK_SECRET=replace-with-your-header-auth-secret

# Optional fallback if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
